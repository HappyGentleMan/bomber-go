# BOMBER GO — public entry (imported by ~/.hermes/etc-from-vps/caddy/Caddyfile.public)
#
# Public URL: https://bomber.119-247-94-77.sslip.io
#   sslip.io resolves *.119-247-94-77.sslip.io → 119.247.94.77 (Anson's public IP),
#   and the router forwards 80/443 → 192.168.0.241.
#   24-11-2026: Caddy now listens on :8443 (not :443). The 443 port is owned by
#   deploy/tls-router.mjs, an SNI router that forwards everything to this site
#   EXCEPT SNI turn.bomber… (that goes to coturn — the 443 TURN relay for
#   corporate networks that block UDP + 3478).
#   Caddy issues the Let's Encrypt cert on first request (HTTP-01 on :80).
#
# Serves the same deploy/current symlink as the loopback site, so the auto-deploy
# watcher updates this URL too — no reload needed after a build.

https://bomber.119-247-94-77.sslip.io:8443 {
	bind 192.168.0.241:8443

	root * "/Users/anson/srv/bomber-go/current"

	encode zstd gzip

	log {
		output stdout
		format console
	}

	header -Server
	header -Strict-Transport-Security
	header X-Content-Type-Options "nosniff"

	# Signaling — self-hosted long-poll server (deploy/signal-server.mjs on
	# 127.0.0.1:9100), NO WebSockets: corporate proxies routinely block the
	# WS `Upgrade` handshake while plain HTTPS works. Same origin as the game,
	# so a network that can load the page can also host/join rooms.
	# handle blocks run in written order, so this runs BEFORE the SPA
	# try_files below (a top-level reverse_proxy would be sorted after it).
	@signal {
		path /signal /signal/*
	}
	handle @signal {
		reverse_proxy 127.0.0.1:9100
	}

	handle {
		# hashed bundle assets — immutable
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# entry document + service worker + build stamp — always revalidate
		@html path / /index.html /net-test.html
		header @html Cache-Control "no-cache"
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		@ver path /version.json
		header @ver Cache-Control "no-cache"

		try_files {path} {path}/ /index.html
		file_server
	}
}
